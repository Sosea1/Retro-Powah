  "category": "items",
  "sortnum": 0,
  "pages": [
    {
      "type": "text",
      "text": "A Battery is portable Forge Energy storage with normal FE capability."
    },
    {
      "type": "text",
      "text": "Sneak-right-click it to toggle auto-charge. While enabled, it charges compatible items in your inventory, armor, and offhand."
    },
    {
      "type": "text",
      "text": "Compatible addon equipment slots are also supported. Other Powah Batteries are skipped automatically."
    },
    {
      "type": "text",
      "text": "Shift-click a Battery into an Ender Cell GUI to consume it as permanent capacity for the selected Ender Network channel. Stored FE is transferred into the channel at the same time."
    },
